# Copy this file to `.env` and fill in your real values.

# LINE Bot credentials
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
# At least 32 random characters; used only by the server to sign LINE import tokens.
LINE_IMPORT_SIGNING_SECRET=replace_with_a_random_32_plus_character_secret

# OpenAI credentials used by ai_linebot_core.app.llm_judge
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# MongoDB Atlas
# 從 Atlas 網頁 → Connect → Drivers 複製連線字串，替換 <username> 與 <password>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=linebot

# LIFF location flow
LIFF_ID=your_liff_id
# Recommended: set the public HTTPS LIFF endpoint directly, e.g. https://example.com/liff/location
LIFF_LOCATION_ENDPOINT_URL=

# Optional external recommendation backend. All three values are required when enabled.
LOCATION_RECOMMENDATION_API_URL=
LOCATION_RECOMMENDATION_API_KEY=
LOCATION_RECOMMENDATION_ALLOWED_HOSTS=api.example.com
# HTTPS link hosts allowed inside backend-generated group messages.
LOCATION_ALLOWED_LINK_HOSTS=www.google.com,maps.google.com,maps.app.goo.gl

#google api key
GOOGLE_PLACES_API_KEY=
